{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevEnvManager",
  "version": "0.2.10-beta",
  "identifier": "com.devenvmanager",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "EnvManager · 开发环境管理",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}